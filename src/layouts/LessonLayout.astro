---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { lessons, href } from '../data/lessons';
interface Props { title: string; topic: string; current: string; sections: {id:string;label:string}[]; }
const { title, topic, current, sections } = Astro.props;
---
<!doctype html>
<html lang="vi">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="color-scheme" content="dark"/><title>{title} · Kiến thức</title><link rel="icon" href={href('favicon.svg')} type="image/svg+xml"/></head>
<body>
<a class="skip" href="#noi-dung">Đến nội dung</a>
<header class="mobile-header"><button id="menu-toggle" aria-label="Mở danh mục bài học" aria-expanded="false" aria-controls="sidebar"><Icon name="menu"/></button><p class="header-slogan">Học - Học nữa - Học mãi</p></header>
<div id="nav-backdrop" hidden></div>
<aside class="sidebar" id="sidebar">
<label class="search"><Icon name="search" size={18}/><input id="lesson-search" type="search" placeholder="Tìm bài học…" aria-label="Tìm bài học" autocomplete="off"/><kbd>/</kbd></label>
<nav aria-label="Danh mục bài học">
{[...new Set(lessons.map(lesson => lesson.topic))].map((category, i)=><section class="nav-group" data-category><h2><span>{category}</span><span class="nav-count">{String(lessons.filter(lesson => lesson.topic === category).length).padStart(2, '0')}</span></h2><ul>{lessons.filter(l=>l.topic===category).map(l=><li data-search={`${l.title} ${l.topic} ${l.keywords}`}><a href={href(l.path)} aria-current={current===l.path?'page':undefined}><Icon name={i===0?'file':'layers'} size={19}/><span>{l.title}</span></a></li>)}</ul></section>)}
<p id="search-empty" hidden>Chưa có bài học phù hợp.<br/>Thử “Dev” hoặc “Auto Layout”.</p>
<p id="search-status" class="sr-only" aria-live="polite"></p>
</nav>
</aside>
<div class="page-shell"><div class="topline"><div class="breadcrumb"><span>{topic}</span><span>/</span><span>{topic==='DevOps'?'Môi trường':'Bố cục'}</span></div></div>
<div class="reading-grid"><main id="noi-dung" tabindex="-1"><slot/></main><nav class="toc" aria-label="Trong bài này"><span class="small-label">TRONG BÀI NÀY</span>{sections.map((s,i)=><a href={`#${s.id}`} class={i===0?'is-active':''}>{s.label}</a>)}</nav></div>
</div>
<script>
const input = document.querySelector<HTMLInputElement>('#lesson-search')!;
const normalize = (value:string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/đ/g,'d').toLowerCase();
input.addEventListener('input',()=>{ let count=0; document.querySelectorAll<HTMLElement>('[data-search]').forEach(item=>{const match=normalize(item.dataset.search || '').includes(normalize(input.value.trim()));item.hidden=!match;if(match)count++;});document.querySelectorAll<HTMLElement>('[data-category]').forEach(group=>{group.hidden=!group.querySelector('[data-search]:not([hidden])');}); document.querySelector<HTMLElement>('#search-empty')!.hidden=count!==0;document.querySelector('#search-status')!.textContent=`${count} bài học phù hợp`; });
const toggle=document.querySelector<HTMLButtonElement>('#menu-toggle')!;
const sidebar=document.querySelector<HTMLElement>('#sidebar')!;
const backdrop=document.querySelector<HTMLElement>('#nav-backdrop')!;
const mobile=window.matchMedia('(max-width: 760px)');
function setMenu(open:boolean){toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Đóng danh mục bài học':'Mở danh mục bài học');sidebar.classList.toggle('is-open',open);backdrop.hidden=!open;document.body.classList.toggle('menu-open',open);sidebar.inert=mobile.matches&&!open;}
toggle.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';setMenu(open);if(open)toggle.focus();});backdrop.addEventListener('click',()=>{setMenu(false);toggle.focus();});
mobile.addEventListener('change',()=>setMenu(false));setMenu(false);
document.addEventListener('keydown',event=>{if(event.key==='Escape' && toggle.getAttribute('aria-expanded')==='true'){setMenu(false);toggle.focus();}if(event.key==='/' && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement)){event.preventDefault();if(mobile.matches)setMenu(true);input.focus();}if(event.key==='Tab'&&mobile.matches&&toggle.getAttribute('aria-expanded')==='true'){const focusable=[toggle,...sidebar.querySelectorAll<HTMLElement>('a[href],input,button')].filter(el=>el.getClientRects().length>0);const first=focusable[0],last=focusable.at(-1)!;if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}}});
const links=[...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
const observer=new IntersectionObserver(entries=>{const active=entries.find(e=>e.isIntersecting);if(active)links.forEach(link=>link.classList.toggle('is-active',link.hash===`#${active.target.id}`));},{rootMargin:'-10% 0px -65% 0px'});links.forEach(link=>{const section=document.querySelector(link.hash);if(section)observer.observe(section);});
</script>
</body></html>
