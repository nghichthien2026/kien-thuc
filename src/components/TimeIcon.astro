name==='On time' ? <><circle cx="30" cy="29" r="23" fill="#c7ecee"/><path d="M30 13v17l10 5" stroke-width="3"/><circle cx="47" cy="46" r="14" fill="#abe3bd"/><path d="m40 46 5 5 9-10" stroke="#326d4b" stroke-width="3"/></> :
<><circle cx="30" cy="32" r="24" fill="#cce5ff"/><path d="M30 15v17H18" stroke="#507da5" stroke-width="3"/><circle cx="48" cy="45" r="13" fill="#ffdc88"/><path d="M44 41a4 4 0 0 1 8 0c0 3-4 3-4 6"/><circle cx="48" cy="52" r="1" fill="#24374b"/></>}
</svg>
