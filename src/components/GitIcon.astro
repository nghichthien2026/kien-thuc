<path d="M25 24V13h26l10 7h38v60H25Z" fill="#398ade"/><path d="M20 29V18h25l10 7h38v60H20Z" fill="#ed716b"/><path d="M14 33V23h25l10 7h39v60H14Z" fill="#96c9f1"/><path d="M8 38V29h26l10 7h38v58H8Z" fill="#f6d25a"/><path d="M8 48h75l-4 44H8Z" fill="#f4c63e"/><path d="M17 42h31" stroke="#fff4b0" stroke-width="5"/>
</>}
{kind==='staging'&&<>
<path d="M12 22V12h37l9 9h48v67H12Z" fill="#78b923"/><path d="M17 27h86v12H17Z" fill="#efe6c9"/><path d="M12 39h97l-4 52H12Z" fill="#8dc719"/><path d="M48 51v27m0-18c0 10 26-2 26 10v8" stroke="#175121" stroke-width="5"/><circle cx="48" cy="51" r="5" fill="#175121"/><circle cx="48" cy="79" r="5" fill="#175121"/><circle cx="74" cy="78" r="5" fill="#175121"/>
</>}
