---
interface Props { kind: 'dev' | 'staging' | 'production'; }
const {kind} = Astro.props;
---
<svg class="environment-art" viewBox="0 0 320 225" role="img" aria-label={kind==='dev'?'Máy tính dùng để viết và thử mã':kind==='staging'?'Máy chủ kiểm tra trước khi phát hành':'Ứng dụng phục vụ người dùng trên toàn cầu'}>
<defs><linearGradient id={`${kind}-face`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#174c87"/><stop offset="1" stop-color="#071a35"/></linearGradient><radialGradient id={`${kind}-glow`}><stop stop-color="#038ddf" stop-opacity=".22"/><stop offset="1" stop-color="#009bff" stop-opacity="0"/></radialGradient><linearGradient id={`${kind}-blue`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#63d8ff"/><stop offset="1" stop-color="#066ff4"/></linearGradient></defs>
<ellipse cx="160" cy="145" rx="155" ry="80" fill={`url(#${kind}-glow)`}/><path d="m20 174 142-54 141 55-143 43Z" stroke="#116493" fill="#08203a" fill-opacity=".35" stroke-dasharray="3 5"/>
{kind==='dev' && <g><path d="m63 151 27-112 161 29-20 110Z" fill="#031323" stroke="#329cff" stroke-width="2"/><path d="m73 143 24-94 144 26-18 94Z" fill={`url(#${kind}-face)`}/><path d="m63 151-33 21 154 37 47-31Z" fill="#123b67" stroke="#329cff"/><path d="m76 157-19 13 128 28 26-17Z" fill="#071f38"/><path d="m117 180 32 8-8 5-32-8Z" fill="#2473a7"/><g stroke-linecap="round" stroke-width="3"><path d="m109 71 29 5m-32 6 13 2m-16 8 44 8m-47 4 17 3m-20 8 37 7m-40 3 22 4" stroke="#32bbfc"/><path d="m149 78 49 9m-69 0 44 8m-15 7 45 8m-72 1 22 4m-9 9 37 7" stroke="#3571aa"/></g><circle cx="99" cy="57" r="2" fill="#28bfff"/><circle cx="107" cy="58" r="2" fill="#4c86ad"/><path d="M263 169v-23c18-9 31-4 29 5-2 12-22 14-29 10m0-15c0 10 24 10 24 0" fill="#092944" stroke="#1f86bd"/><path d="M48 143V99m0 18c-17-2-23-14-21-23 16 3 23 10 21 23Zm0-10c-1-18 5-27 16-31 5 14-1 23-16 31Z" fill="#12618a" stroke="#1987b9"/><path d="m35 133 26 4-5 24-15-2Z" fill="#0c3658" stroke="#1b80b0"/></g>}
{kind==='staging' && <g>{[{x:55,y:85},{x:127,y:62},{x:199,y:102}].map(({x,y})=><g>{[0,29,58].map(offset=><g><path d={`m${x} ${y+offset} 41-19 52 17-43 20Z`} fill="#2161a3" stroke="#3a8dc9"/><path d={`m${x} ${y+offset} 50 18v25l-50-18Z`} fill={`url(#${kind}-face)`} stroke="#205b8d"/><path d={`m${x+50} ${y+18+offset} 43-20v25l-43 20Z`} fill="#092341" stroke="#205b8d"/><path d={`m${x+9} ${y+12+offset} 18 6`} stroke="#52c7ff" stroke-width="3"/><circle cx={x+39} cy={y+23+offset} r="2.5" fill="#37e5c4"/></g>)}</g>)}<path d="M152 40V16l78 14v49" stroke="#16548b" fill="none"/><path d="m164 29 29 5m-29 5 47 8" stroke="#1268a2" stroke-width="3"/></g>}
{kind==='production' && <g><circle cx="163" cy="112" r="77" fill={`url(#${kind}-face)`} stroke="#40bcff"/><ellipse cx="163" cy="112" rx="37" ry="77" fill="none" stroke="#2293d2" opacity=".7"/><ellipse cx="163" cy="112" rx="77" ry="27" fill="none" stroke="#2293d2" opacity=".7"/><path d="M88 112h151M163 35v154" stroke="#2388bd" opacity=".65"/><path d="m112 64 18-13 22 6 3 16-13 11-1 15-17 7-8-15-19-5Zm57-16 26 1 23 17-9 13 8 14-23 10-13-13-19 4-13-13 13-18Zm-27 63 18 11 7 18-12 22-11 12-9-27-14-12Zm49 24 22-8 10 14-13 12-20-4Z" fill={`url(#${kind}-blue)`} opacity=".85"/><ellipse cx="163" cy="113" rx="121" ry="45" transform="rotate(-23 163 113)" fill="none" stroke="#18b3f7" stroke-width="1.3"/><ellipse cx="163" cy="113" rx="119" ry="52" transform="rotate(38 163 113)" fill="none" stroke="#086497"/><circle cx="75" cy="159" r="3" fill="#7fe8ff"/><circle cx="243" cy="58" r="3" fill="#7fe8ff"/>{[{x:54,y:65},{x:271,y:123},{x:179,y:17}].map(({x,y})=><g><circle cx={x} cy={y} r="17" fill="#071d33" stroke="#258aca"/><circle cx={x} cy={y-4} r="4" fill="#37adf4"/><path d={`M${x-7} ${y+9}v-3a7 7 0 0 1 14 0v3Z`} fill="#37adf4"/></g>)}</g>}
</svg>
