  {motif === 8 && (
    <g>
      <path d="M8 41c6-9 12-13 20-15v6C20 35 14 40 8 46v-5Zm48 0c-6-9-12-13-20-15v6c8 3 14 8 20 14v-5Z" fill="currentColor" fill-opacity=".08" />
