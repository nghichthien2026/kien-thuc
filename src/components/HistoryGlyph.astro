      <path d="M10 44h6m33 0h5M11 33h3m37-2h3" stroke-opacity=".5" />
    </g>
  )}
  {motif === 2 && (
    <g>
      <path d="M10 38h44l-8 10H20L10 38Z" fill="currentColor" fill-opacity=".09" />
      <path d="M31 11v27M28 15 13 32h15V15Zm7-4 15 21H35V11Z" fill="currentColor" fill-opacity=".06" />
      <path d="M14 42h36M8 52c4-3 8-3 12 0s8 3 12 0 8-3 12 0 8 3 12 0M10 57c3-2 6-2 9 0m26 0c3-2 6-2 9 0" />
      <path d="M10 19h6m30-5h7" stroke-opacity=".5" />
    </g>
  )}
  {motif === 3 && (
    <g>
      <path d="M18 13h28v32a6 6 0 0 1-6 6H18V13Z" fill="currentColor" fill-opacity=".07" />
      <path d="M18 13a5 5 0 0 0-10 0v5h10M18 13v32M18 45H8v3a6 6 0 0 0 6 6h27a5 5 0 0 0 5-5M46 13h4a6 6 0 0 1 6 6v2H46M25 23h14M25 29h14M25 35h9" />
      <path d="m36 43 3 2 3-2v8l-3-2-3 2v-8Z" fill="currentColor" fill-opacity=".13" />
    </g>
  )}
  {motif === 4 && (
    <g>
      <path d="M27 56V43c0-8-6-10-11-14-4-3-6-8-6-15h9c0 5 2 8 5 10l8 6 8-6c3-2 5-5 5-10h9c0 7-2 12-6 15-5 4-11 6-11 14v13H27Z" fill="currentColor" fill-opacity=".08" />
      <path d="M32 54v-6m0-5v-5m-4-5-5-4m-5-5-3-5m21 14 5-4m5-5 3-5" stroke-dasharray="2 3" />
      <path d="m8 17 7-7 7 7m20 0 7-7 7 7M32 24V9m-5 5 5-5 5 5" />
      <path d="M7 43h9m32 0h9" stroke-opacity=".5" />
    </g>
  )}
  {motif === 5 && (
    <g>
