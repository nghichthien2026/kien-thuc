---
interface Props {
  index: number;
}

const { index } = Astro.props;
const motif = Number.isInteger(index) && index >= 0 && index < 10 ? index : 0;
---

<!-- Conceptual period markers, rather than reconstructions of historical objects. -->
<svg
  width="64"
  height="64"
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {motif === 0 && (
    <g>
      <path d="M12 24v20c0 6 40 6 40 0V24" fill="currentColor" fill-opacity=".08" />
      <ellipse cx="32" cy="23" rx="22" ry="12" fill="currentColor" fill-opacity=".06" />
      <ellipse cx="32" cy="23" rx="17" ry="8" />
      <path d="m32 17 2 4 6-1-4 3 4 3-6-1-2 4-2-4-6 1 4-3-4-3 6 1 2-4Z" fill="currentColor" fill-opacity=".12" />
      <path d="M12 36c8 6 32 6 40 0M12 41c8 6 32 6 40 0M19 33v6m7-4v6m12-6v6m7-8v6M10 27l-3 2v9l5 2m42-13 3 2v9l-5 2" />
    </g>
  )}
  {motif === 1 && (
    <g>
      <path d="M32 32C18 32 13 25 14 14c11 0 19 6 18 18ZM33 24c0-11 7-17 18-17 0 11-7 18-18 17Z" fill="currentColor" fill-opacity=".09" />
