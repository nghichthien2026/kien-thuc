---
import LessonLayout from '../../layouts/LessonLayout.astro';
import ChatPortrait from '../../components/ChatPortrait.astro';
import '../../styles/neumorphism-chat.css';
const people=[{id:'alex',name:'Alex R.'},{id:'sarah',name:'Sarah K.',badge:'3'},{id:'team',name:'Team Project',badge:'5'},{id:'marketing',name:'Marketing Updates',badge:'9'},{id:'family',name:'Family Chat',badge:'@ 2'},{id:'john',name:'John D.'},{id:'emily',name:'Emily W.'},{id:'support',name:'Tech Support',badge:'dot'},{id:'gaming',name:'Gaming Grp',badge:'99+'}];
---
<LessonLayout title="Neumorphism Chat" topic="Thiết kế" subtitle="Giao diện trò chuyện mềm" current="thiet-ke/neumorphism-chat/" sections={[{id:'chat-intro',label:'Neumorphism Chat'},{id:'chat-demo',label:'Giao diện trò chuyện'},{id:'chat-notes',label:'Ánh sáng & chiều sâu'}]}>
<article class="nc-article"><header class="nc-intro" id="chat-intro"><span class="nc-eyebrow">SOFT INTERFACES / 05</span><h1 class="lesson-title">Neumorphism Chat</h1><p>Nền xám dịu, những khối nổi mềm và sắc xanh điện tạo nên một không gian trò chuyện đầy chiều sâu.</p></header>
<section class="nc-stage" id="chat-demo" aria-label="Bản mô phỏng giao diện trò chuyện Neumorphism">
<div class="nc-app">
<div class="nc-toolbar"><div class="nc-tabs" role="tablist" aria-label="Lọc hội thoại"><button type="button" role="tab" id="nc-all" aria-selected="true" aria-controls="nc-contacts" tabindex="0" data-filter="all">All</button><button type="button" role="tab" id="nc-unread" aria-selected="false" aria-controls="nc-contacts" tabindex="-1" data-filter="unread">Unread</button><button type="button" role="tab" id="nc-mentions" aria-selected="false" aria-controls="nc-contacts" tabindex="-1" data-filter="mentions">Mentions <span class="nc-tab-badge">4</span></button></div></div>
<div class="nc-body"><div class="nc-contacts" id="nc-contacts" role="tabpanel" aria-labelledby="nc-all"><div class="nc-contact-list" aria-label="Hội thoại minh họa">{people.map(p=><button type="button" class="nc-contact" data-person={p.id} data-name={p.name} data-unread={p.badge&&p.badge!=='dot'?'true':'false'} data-mention={p.id==='family'?'true':'false'} aria-pressed={p.id==='sarah'?'true':'false'} aria-label={`${p.name}${p.badge&&p.badge!=='dot'?`, ${p.badge} thông báo mẫu`:''}`}><ChatPortrait person={p.id}/><span class="nc-name">{p.name}</span>{p.badge&&<span class:list={['nc-badge',{'mention':p.id==='family','quiet':p.badge==='dot'}]}>{p.badge==='dot'?'':p.badge}</span>}</button>)}</div></div>
<div class="nc-conversation" aria-label="Nội dung hội thoại mẫu"><header class="nc-chat-header"><span class="nc-header-avatar">{people.map(p=><span data-header-person={p.id} hidden={p.id!=='sarah'}><ChatPortrait person={p.id} instance="header"/></span>)}<i aria-label="Trực tuyến trong bản mẫu"></i></span><span id="nc-chat-name">Sarah K.</span></header>
<div class="nc-messages" id="nc-sarah-messages" lang="en"><div class="nc-message sent"><div class="nc-meta"><time>10:45 AM</time><span>User</span></div><p>Hey Sarah, did you see the latest design draft?</p></div><div class="nc-message received"><div class="nc-meta"><span>Sarah K.</span><time>11:12 AM</time></div><p>Yes, I did. It looks great! Just a few comments on the color palette.</p></div><div class="nc-message sent"><div class="nc-meta"><time>11:12 AM</time><span>User</span></div><p>Got it. I'll check the feedback now. Thanks!</p></div><div class="nc-message received"><div class="nc-meta"><span>Sarah K.</span><time>11:12 AM</time></div><p>No problem. Let's sync later.</p></div></div>
<div id="nc-empty" class="nc-empty" hidden><span>CONVERSATION PREVIEW</span><p>Hội thoại minh họa</p><small>Chọn Sarah K. để xem bản mẫu trong hình.</small></div>
</div></div></div>
</section>
<div class="nc-demo-caption"><p id="nc-status" role="status" aria-live="polite">Thử chọn bộ lọc hoặc một hội thoại</p><button type="button" id="nc-reset">Đặt lại bản mẫu <span aria-hidden="true">↺</span></button></div>
<section class="nc-notes" id="chat-notes"><div><span>01 / ÁNH SÁNG</span><h2>Nổi lên từ nền</h2><p>Ánh sáng trên phải và bóng đổ dưới trái làm từng bề mặt như được đúc từ cùng một chất liệu.</p></div><div><span>02 / ĐIỂM NHẤN</span><h2>Xanh điện, đỏ hồng</h2><p>Bong bóng xanh bóng và huy hiệu đỏ rực dẫn mắt qua nền bạc, giúp phân biệt thông tin ngay lập tức.</p></div><div><span>03 / NHỊP ĐIỆU</span><h2>Mềm mà rõ ràng</h2><p>Góc bo rộng, avatar tròn và khoảng cách nhất quán giữ giao diện dễ đọc, nhẹ nhàng và có trật tự.</p></div></section><p class="nc-disclosure">Tất cả tên, chân dung và hội thoại đều là dữ liệu minh họa. Các thao tác chỉ thay đổi bản demo trên trang, không gửi tin nhắn hay truy cập danh bạ.</p>
</article></LessonLayout>
<script>
const root=document.querySelector<HTMLElement>('.nc-article')!;
const tabs=[...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
const contacts=[...root.querySelectorAll<HTMLButtonElement>('[data-person]')];
const status=root.querySelector<HTMLElement>('#nc-status')!;
function select(person:string){const selected=contacts.find(c=>c.dataset.person===person)!;contacts.forEach(c=>c.setAttribute('aria-pressed',String(c===selected)));root.querySelector('#nc-chat-name')!.textContent=selected.dataset.name!;root.querySelectorAll<HTMLElement>('[data-header-person]').forEach(p=>p.hidden=p.dataset.headerPerson!==person);root.querySelector<HTMLElement>('#nc-sarah-messages')!.hidden=person!=='sarah';root.querySelector<HTMLElement>('#nc-empty')!.hidden=person==='sarah';status.textContent=`Đang xem ${selected.dataset.name} · hội thoại minh họa`;}
function filter(tab:HTMLButtonElement){tabs.forEach(t=>{t.setAttribute('aria-selected',String(t===tab));t.tabIndex=t===tab?0:-1;});root.querySelector('#nc-contacts')!.setAttribute('aria-labelledby',tab.id);contacts.forEach(c=>c.hidden=tab.dataset.filter==='unread'?c.dataset.unread!=='true':tab.dataset.filter==='mentions'?c.dataset.mention!=='true':false);const current=contacts.find(c=>c.getAttribute('aria-pressed')==='true')!;if(current.hidden)select(contacts.find(c=>!c.hidden)!.dataset.person!);status.textContent=`${contacts.filter(c=>!c.hidden).length} hội thoại minh họa · ${tab.dataset.filter==='all'?'tất cả':tab.dataset.filter==='unread'?'chưa đọc':'lượt nhắc'}`;}
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>filter(tab));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index+tabs.length-1)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();tabs[next].focus();filter(tabs[next]);});});contacts.forEach(c=>c.addEventListener('click',()=>select(c.dataset.person!)));root.querySelector('#nc-reset')!.addEventListener('click',()=>{filter(tabs[0]);select('sarah');status.textContent='Đã đặt lại bản mẫu · Sarah K.';});
</script>
