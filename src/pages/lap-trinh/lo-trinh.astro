---
import LessonLayout from '../../layouts/LessonLayout.astro';
import RoadmapArt from '../../components/RoadmapArt.astro';
import data from '../../data/developer-roadmap.json';
import '../../styles/roadmap.css';
const colors=['#63caff','#a9da74','#ffb46c','#c6a0f5','#f6d25e','#62dedc','#f2a0c9','#a6b4ff'];
const kinds=['web','frontend','backend','database','deploy','ai','cloud','architecture'];
const sections=[{id:'bat-dau',label:'Bắt đầu từ đâu?'},{id:'ban-do',label:'8 chặng phát triển'},{id:'hoc-chi-tiet',label:'Học từng chặng'},{id:'ket-noi',label:'Kết nối công nghệ'},{id:'du-an',label:'Dự án thực hành'},{id:'tai-lieu',label:'Tài liệu chính thức'}];
const layers=[
 {kind:'frontend',title:'Giao diện',text:'Trình duyệt gửi yêu cầu HTTP và hiển thị kết quả. HTML, CSS, JavaScript; thêm framework khi cần.'},
 {kind:'backend',title:'API & nghiệp vụ',text:'Server kiểm tra dữ liệu, xác thực và phân quyền trước khi xử lý yêu cầu.'},
 {kind:'database',title:'Dữ liệu',text:'API đọc / ghi PostgreSQL bằng truy vấn có tham số. Trình duyệt không giữ mật khẩu database.'},
];
const supports=[
 {kind:'ai',title:'AI → API',text:'Nhánh tùy chọn: backend gọi mô hình và truy xuất tài liệu; giữ khóa API ở server.'},
 {kind:'deploy',title:'CI/CD → ứng dụng',text:'Kiểm thử, build rồi phát hành frontend và backend lên môi trường phù hợp.'},
 {kind:'cloud',title:'Giám sát → toàn hệ thống',text:'Theo dõi lỗi, hiệu năng, chi phí; cảnh báo và phục hồi khi có sự cố.'},
];
const projects=[
 {kind:'web',title:'Trang ghi chú học tập',text:'Một trang HTML/CSS đọc được trên điện thoại, dùng nội dung tự viết.',stage:'01 · NỀN TẢNG'},
 {kind:'backend',title:'Ứng dụng ghi chú',text:'Thêm, sửa, tìm kiếm ghi chú; sau đó kết nối API và PostgreSQL với dữ liệu giả.',stage:'02–04 · FULL STACK'},
 {kind:'deploy',title:'Bản demo trực tuyến',text:'Test tự động, phát hành có thể lặp lại và khôi phục bản ổn định.',stage:'05 · TRIỂN KHAI'},
 {kind:'ai',title:'Trợ lý tra cứu',text:'Hỏi đáp tài liệu công khai, kèm nguồn và bộ câu hỏi đánh giá.',stage:'06 · MỞ RỘNG TÙY CHỌN'},
];
---
<LessonLayout title="Lộ trình lập trình viên" topic="Lập trình" subtitle="Lộ trình phát triển" current="lap-trinh/lo-trinh/" sections={sections}>
<article class="roadmap">
<header class="roadmap-hero">
<p class="kicker">{data.eyebrow}</p>
<h1 class="lesson-title">Lộ trình <em>lập trình viên.</em></h1>
<p class="roadmap-deck">{data.title}.<br/>{data.subtitle}</p>
<div class="roadmap-loop" aria-label="Học, xây dựng, triển khai và phát triển"><span>HỌC</span><b aria-hidden="true">→</b><span>XÂY DỰNG</span><b aria-hidden="true">→</b><span>TRIỂN KHAI</span><b aria-hidden="true">→</b><span>PHÁT TRIỂN</span></div>
</header>
<div class="roadmap-guide"><p>{data.intro}</p><p><strong>Đường đi gợi ý</strong><br/>{data.pathNote}</p></div>
<section id="bat-dau" class="roadmap-start" aria-labelledby="start-title">
<p class="kicker">BẮT ĐẦU Ở ĐÂY</p><h2 id="start-title">{data.firstSession.title}</h2>
<ol>{data.firstSession.steps.map(step=><li>{step}</li>)}</ol>
<p class="roadmap-start-done"><strong>Kết quả buổi đầu:</strong> {data.firstSession.done}</p>
<details><summary>Cách học và thứ tự nên đi</summary><ul>{data.learningMethod.map(item=><li>{item}</li>)}</ul><ul>{data.dependencyGuide.map(item=><li>{item}</li>)}</ul></details>
<a class="roadmap-study-link" href="#hoc-01">Vào bài đầu tiên →</a>
</section>
<section id="ban-do" aria-labelledby="map-title">
<div class="roadmap-heading"><span>01 / BẢN ĐỒ</span><h2 id="map-title">8 chặng phát triển</h2></div>
<p class="roadmap-section-intro">Chặng 01–05 là nền tảng cốt lõi. Chặng 06–08 là hướng đào sâu; bạn không cần đi hết mọi nhánh. Chọn “Học chi tiết” để xem thứ tự bài học, bài tập và tiêu chí qua chặng.</p>
<div class="roadmap-phase-grid">
{data.phases.map((phase,i)=><section class="roadmap-phase" id={`chang-${phase.id}`} style={`--accent:${colors[i]}`} aria-labelledby={`title-${phase.id}`}>
<header class="roadmap-phase-header"><span class="roadmap-number">{i+1}</span><div><p class="phase-label">{phase.track==='core'?'Cốt lõi':'Chuyên sâu'} · {phase.id}</p><h3 id={`title-${phase.id}`}>{phase.title}</h3></div></header>
<RoadmapArt kind={kinds[i]}/>
<ul class="roadmap-skill-list">{phase.topics.map(topic=><li>{topic}</li>)}</ul>
<div class="roadmap-goal"><span>◎ MỤC TIÊU</span><p>{phase.goal}</p></div>
<a class="roadmap-study-link" href={`#hoc-${phase.id}`}>Học chi tiết chặng {phase.id} <span aria-hidden="true">→</span></a>
</section>)}
</div>
</section>
<section id="hoc-chi-tiet" aria-labelledby="curriculum-title">
<div class="roadmap-heading"><span>02 / HỌC TỪNG BƯỚC</span><h2 id="curriculum-title">Cụ thể cần học gì?</h2></div>
<p class="roadmap-section-intro">Mỗi chặng học theo thứ tự từ trên xuống. Mở một bài, học khái niệm rồi tự làm bài tập; chỉ qua chặng khi tự kiểm tra được kết quả. Dự án xuyên suốt được gợi ý là một ứng dụng ghi chú học tập; bạn có thể đổi chủ đề nhưng giữ các yêu cầu thực hành tương đương.</p>
<nav class="roadmap-course-nav" aria-label="Chọn chặng học chi tiết">{data.phases.map((phase,i)=><a href={`#hoc-${phase.id}`} style={`--accent:${colors[i]}`}>{phase.id} · {phase.title}</a>)}</nav>
{data.phases.map((phase,i)=><section class="roadmap-course" id={`hoc-${phase.id}`} style={`--accent:${colors[i]}`} aria-labelledby={`course-title-${phase.id}`}>
<header class="roadmap-course-header"><span class="roadmap-number">{phase.id}</span><div><p class="phase-label">{phase.track==='core'?'NỀN TẢNG CỐT LÕI':'NHÁNH ĐÀO SÂU TÙY CHỌN'}</p><h3 id={`course-title-${phase.id}`}>{phase.title}</h3></div></header>
<p class="roadmap-prerequisite"><strong>Trước khi bắt đầu:</strong> {phase.prerequisite}</p>
<p class="roadmap-default"><strong>Đường học mặc định:</strong> {phase.defaultPath}</p>
<ol class="roadmap-modules">{phase.modules.map((module,j)=><li><details class="roadmap-module" id={`bai-${phase.id}-${module.id}`} open={i===0&&j===0}><summary><span class="module-number">{module.id}</span>{' '}<span>{module.title}</span></summary>
<div class="roadmap-module-body"><h4>1. Học những gì?</h4><ul>{module.concepts.map(concept=><li>{concept}</li>)}</ul>
<h4>2. Tự thực hành</h4><p>{module.exercise}</p>
<div class="roadmap-module-result"><p><strong>Sản phẩm cần có:</strong> {module.output}</p><p><strong>Tự kiểm tra:</strong> {module.selfCheck}</p></div>
<p class="module-source-label">Đọc đúng phần này:</p><ul class="roadmap-module-sources">{module.sourceIds.map(id=>{const source=data.sources.find(s=>s.id===id);return source&&<li><a href={source.url}>{source.title}</a></li>;})}</ul>
{module.id==='03.3'&&<p class="roadmap-learning-handoff"><strong>Dừng ở đây để học SQL:</strong> <a href="#hoc-04">Học 04.1–04.3 trước khi làm 03.4 →</a></p>}
{module.id==='04.3'&&<p class="roadmap-learning-handoff"><strong>Đã có nền SQL:</strong> <a href="#bai-03-03.4">Quay lại 03.4 để nối database →</a>, sau đó hoàn tất 04.4–04.5.</p>}
</div>
</details></li>)}</ol>
<div class="roadmap-course-check"><h4>Qua chặng khi bạn tự làm được</h4><ul>{phase.completionChecks.map(check=><li>{check}</li>)}</ul></div>
<details class="roadmap-extra"><summary>Lỗi thường gặp & phần có thể học sau</summary><h4>Tránh những lỗi này</h4><ul>{phase.commonMistakes.map(item=><li>{item}</li>)}</ul><h4>Có thể học sau</h4><ul>{phase.optionalTools.map(item=><li>{item}</li>)}</ul></details>
<a class="roadmap-next" href={i<7?`#hoc-${data.phases[i+1].id}`:'#du-an'}>{i===4?'Đã xong nền tảng? Xem nhánh AI tùy chọn':i<7?`Xem chặng ${data.phases[i+1].id}`:'Xem dự án gợi ý'} →</a>
</section>)}
</section>
<section id="ket-noi" aria-labelledby="stack-title"><div class="roadmap-heading"><span>03 / HỆ THỐNG</span><h2 id="stack-title">Các lớp kết nối ra sao?</h2></div>
<p class="roadmap-section-intro">Luồng cơ bản: giao diện → API → cơ sở dữ liệu; kết quả quay lại theo chiều ngược lại. AI là tính năng thêm vào backend. Triển khai và giám sát phục vụ toàn ứng dụng.</p>
<ol class="roadmap-stack roadmap-request" aria-label="Luồng yêu cầu từ trình duyệt đến dữ liệu">{layers.map(layer=><li><RoadmapArt kind={layer.kind}/><h3>{layer.title}</h3><p>{layer.text}</p></li>)}</ol>
<div class="roadmap-stack roadmap-support" aria-label="Các lớp hỗ trợ hệ thống">{supports.map(layer=><div><RoadmapArt kind={layer.kind}/><h3>{layer.title}</h3><p>{layer.text}</p></div>)}</div>
<p class="roadmap-architecture-note"><strong>Kiến trúc là cách tổ chức các lớp.</strong> {data.phases[7].note} Không có bộ công nghệ duy nhất phù hợp mọi sản phẩm.</p>
</section>
<section id="du-an" aria-labelledby="project-title"><div class="roadmap-heading"><span>04 / THỰC HÀNH</span><h2 id="project-title">Học bằng một sản phẩm</h2></div><p class="roadmap-section-intro">{data.capstone.text}</p>
<div class="roadmap-projects">{projects.map(project=><section class="roadmap-project"><RoadmapArt kind={project.kind}/><h3>{project.title}</h3><p>{project.text}</p><span>{project.stage}</span></section>)}</div>
<div class="roadmap-checklist"><h3>Mỗi phiên bản cần có</h3><ul>{data.capstone.deliverables.map(item=><li>{item}</li>)}</ul></div>
<p class="roadmap-section-intro">{data.capstone.privacy}</p>
<div class="roadmap-principles">{data.principles.map(p=><p><strong>{p.title}.</strong> {p.text}</p>)}</div>
</section>
<section id="tai-lieu" class="roadmap-references"><details><summary>{data.sourcesTitle}</summary><ul>{data.sources.map(source=><li id={`nguon-${source.id}`}><a href={source.url}>{source.title}</a></li>)}</ul><p>{data.editorialNote} Tham khảo tài liệu ngày 10/10/2026.</p></details></section>
<p class="roadmap-end"><strong>KIÊN TRÌ + THỰC HÀNH + SẢN PHẨM THẬT</strong><br/>{data.closing}</p>
</article>
</LessonLayout>
