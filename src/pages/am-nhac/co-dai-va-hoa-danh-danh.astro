---
import LessonLayout from '../../layouts/LessonLayout.astro';
import GardeniaArt from '../../components/GardeniaArt.astro';
import { songSections } from '../../data/gardenia-song';
import '../../styles/gardenia-song.css';
const title = 'Cỏ Dại Và Hoa Dành Dành';
const sections = [{ id: 'nghe-bai-hat', label: 'Nghe bài hát' }, ...songSections];
---
<LessonLayout title={title} topic="Âm nhạc" subtitle="Góc hát theo" current="am-nhac/co-dai-va-hoa-danh-danh/" sections={sections}>
  <article class="gardenia-song">
    <header class="gardenia-hero">
      <p class="gardenia-kicker"><span></span> GÓC HÁT THEO <span></span></p>
      <h1 class="lesson-title">{title}</h1>
      <p class="gardenia-byline">Đặng Thanh Tuyền</p>
      <GardeniaArt />
    </header>

    <section class="gardenia-listen" id="nghe-bai-hat" aria-labelledby="gardenia-listen-title">
      <div class="gardenia-section-heading"><h2 id="gardenia-listen-title">Nghe bài hát</h2><span>VIDEO CHÍNH THỨC</span></div>
      <div class="gardenia-video">
        <iframe src="https://www.youtube.com/embed/Zb6zrxrHv14?playsinline=1" title="Cỏ Dại Và Hoa Dành Dành · Đặng Thanh Tuyền trên YouTube" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen></iframe>
      </div>
      <a class="gardenia-youtube" href="https://www.youtube.com/watch?v=Zb6zrxrHv14" target="_blank" rel="noopener noreferrer">Mở trên YouTube <svg viewBox="0 0 20 20" width="15" height="15" fill="none" aria-hidden="true"><path d="M5 15 15 5M5 5h10v10" stroke="currentColor" stroke-width="1.4"/></svg></a>
    </section>

    <div class="gardenia-toolbar" hidden aria-label="Tùy chỉnh lời hát">
      <div class="gardenia-font-controls"><span>Cỡ chữ</span><button type="button" id="gardenia-smaller" aria-label="Giảm cỡ chữ lời hát" aria-controls="gardenia-lyrics">A−</button><button type="button" id="gardenia-larger" aria-label="Tăng cỡ chữ lời hát" aria-controls="gardenia-lyrics">A+</button></div>
      <button type="button" id="gardenia-scroll" aria-pressed="false" aria-controls="gardenia-lyrics"><svg viewBox="0 0 20 20" width="16" height="16" fill="none" aria-hidden="true"><path d="M10 3v13m-5-5 5 5 5-5" stroke="currentColor" stroke-width="1.5"/></svg><span>Tự cuộn</span></button>
      <span class="sr-only" id="gardenia-status" role="status" aria-live="polite"></span>
    </div>

    <div class="gardenia-lyrics" id="gardenia-lyrics">
      {songSections.map((section, index) => (
        <section id={section.id} class:list={['gardenia-verse', { 'gardenia-chorus': section.kind === 'chorus' }]} aria-labelledby={`${section.id}-title`}>
          <header class="gardenia-verse-heading"><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h2 id={`${section.id}-title`}>{section.label}</h2><i aria-hidden="true"></i></header>
          <div class="gardenia-stanzas">{section.stanzas.map(stanza => <p class="gardenia-stanza">{stanza.map(line => <span class="gardenia-line">{line}</span>)}</p>)}</div>
        </section>
      ))}
    </div>
    <div class="gardenia-end" aria-hidden="true"><span></span><svg viewBox="0 0 32 32" width="29" height="29" fill="none"><path d="M16 17C6 18 4 9 10 8C8 1 18 1 19 8C27 4 31 14 23 17C29 24 19 29 16 22C8 27 3 19 10 16M16 17l2-6m-2 6-6-3m6 3 5 3" stroke="currentColor" stroke-width="1.2"/></svg><span></span></div>
  </article>
  <script>
    import '../../scripts/gardenia-song';
  </script>
</LessonLayout>
