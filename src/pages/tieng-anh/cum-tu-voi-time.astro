---
import LessonLayout from '../../layouts/LessonLayout.astro';
import TimeIcon from '../../components/TimeIcon.astro';
import TimeScene from '../../components/TimeScene.astro';
import '../../styles/time-expressions.css';
const sections=[{id:'tu-khoa',label:'13 cụm cần nhớ'},{id:'ban-do',label:'Time trong tình huống'},{id:'nhung-lan',label:'Những lần'},{id:'quy-thoi-gian',label:'Quỹ thời gian'},{id:'dong-ho',label:'Giờ giấc'},{id:'de-nham',label:'Last time ≠ luôn là lần cuối'},{id:'luyen-tap',label:'Luyện tập 5 câu'},{id:'tu-noi',label:'Đưa vào đời sống'},{id:'nguon',label:'Nguồn tham khảo'}];
const groups=[
 {id:'nhung-lan',title:'Nói về những lần',tag:'NHỮNG LẦN',description:'Ở đây, time mang nghĩa “lần”: một lần xảy ra của sự việc, không phải giờ trên đồng hồ.',icon:'↻',cards:[
 ['One more time','Thêm một lần nữa','Could you say that one more time?','Bạn có thể nói lại thêm một lần nữa không?','Dùng khi muốn lặp lại một hành động. “One more” nhấn mạnh thêm một lần.'],
 ['Last time','Lần trước','Last time I forgot my notebook.','Lần trước tôi quên mang vở.','Thường đặt đầu hoặc cuối câu để nhắc đến lần trước đó.'],
 ['Next time','Lần sau','Next time, let’s meet earlier.','Lần sau, mình gặp nhau sớm hơn nhé.','Dùng cho dịp tiếp theo. Thông thường không thêm “in” hoặc “on” trước next time.'],
 ['This time','Lần này','This time I’m ready.','Lần này tôi đã sẵn sàng.','So sánh lần hiện tại với những lần khác.'],
 ['First time','Lần đầu tiên','This is my first time here.','Đây là lần đầu tiên tôi đến đây.','Khi đặt vào câu, thường cần từ đứng trước: my first time, the first time hoặc for the first time.'],
 ['The last time','Lần gần nhất / lần cuối','The last time I saw Lan, she was in Hanoi.','Lần gần nhất tôi gặp Lan, cô ấy đang ở Hà Nội.','Ngữ cảnh quyết định nghĩa. Có “the” không tự động biến cụm này thành “lần cuối mãi mãi”.']
 ]},
 {id:'quy-thoi-gian',title:'Dùng thời gian thế nào?',tag:'QUỸ THỜI GIAN',description:'Thời gian có thể là lúc rảnh, lúc chờ, hoặc khoảng dành cho một việc. Học cả thái độ mà câu nói thể hiện.',icon:'◷',cards:[
 ['Waste time','Lãng phí thời gian','Don’t waste time arguing.','Đừng lãng phí thời gian tranh cãi.','Mẫu hay dùng: waste time + V-ing, hoặc waste time on + danh từ. Thường có ý đánh giá không đáng làm.'],
 ['Kill time','Làm gì đó cho qua thời gian','We played a game to kill time while waiting for the bus.','Chúng tôi chơi một trò chơi cho qua thời gian trong lúc chờ xe buýt.','Nhấn mạnh lấp khoảng chờ; không nhất thiết chê việc đó vô ích như waste time.'],
 ['Free time','Thời gian rảnh','I read in my free time.','Tôi đọc sách vào thời gian rảnh.','Mẫu tự nhiên: in my/your free time. Hãy ghép với sở thích của bạn.'],
 ['Take your time','Cứ từ từ, đừng vội','Take your time. We’re not in a hurry.','Cứ từ từ. Chúng ta không vội đâu.','Một lời trấn an lịch sự: bạn có thể dành đủ thời gian, không cần làm gấp.']
 ]},
 {id:'dong-ho',title:'Nhìn vào đồng hồ',tag:'GIỜ GIẤC',description:'Ba cụm giúp hỏi giờ, giữ đúng hẹn và báo rằng thời gian cho phép đã kết thúc.',icon:'◴',cards:[
 ['Time is up','Hết giờ rồi','Time is up. Please stop writing.','Hết giờ rồi. Vui lòng dừng viết.','Thường gặp trong bài kiểm tra hoặc trò chơi có giới hạn thời gian. Cũng có dạng rút gọn: Time’s up.'],
 ['On time','Đúng giờ','The meeting started on time.','Cuộc họp bắt đầu đúng giờ.','Đúng thời điểm đã hẹn hoặc được lên lịch. “In time” thường là kịp trước khi quá muộn.'],
 ['What time','Mấy giờ','What time does the class start?','Lớp học bắt đầu lúc mấy giờ?','Hỏi giờ hiện tại: What time is it? Hỏi giờ diễn ra hoạt động: What time does … start?']
 ]}
];
const questions=[
 {before:'Could you explain that',after:'? I didn’t understand.',answer:'one more time',meaning:'Bạn có thể giải thích lại một lần nữa không? Tôi chưa hiểu.'},
 {before:'I enjoy cooking in my',after:'.',answer:'free time',meaning:'Tôi thích nấu ăn vào thời gian rảnh.'},
 {before:'Please arrive',after:'. The interview starts at nine.',answer:'on time',meaning:'Hãy đến đúng giờ. Buổi phỏng vấn bắt đầu lúc chín giờ.'},
 {before:'',after:'! Put your pens down.',answer:'Time is up',meaning:'Hết giờ rồi! Hãy đặt bút xuống.'},
 {before:'',after:'. You don’t need to decide immediately.',answer:'Take your time',meaning:'Cứ từ từ. Bạn không cần quyết định ngay.'}
];
const expressionId=(value:string)=>'cum-'+value.toLowerCase().replace(/[^a-z0-9]+/g,'-');
const keywords=groups.flatMap(group=>group.cards.map(card=>({english:card[0],meaning:card[0]==='Kill time'?'Làm gì đó cho qua giờ':card[1]})));

---
<LessonLayout title="13 cụm từ tiếng Anh với time" topic="Tiếng Anh" subtitle="Từ vựng mỗi ngày" current="tieng-anh/cum-tu-voi-time/" sections={sections}>
<article class="time-lesson">
<header class="time-hero time-hero-compact">
 <div class="time-eyebrow">TIẾNG ANH MỖI NGÀY <span>13 CỤM TỪ</span></div>
 <h1>Nhớ ngay 13 cụm với <em lang="en">time</em></h1>
</header>
<nav id="tu-khoa" class="time-keywords" aria-label="13 cụm từ quan trọng và nghĩa tiếng Việt">
 <div>{keywords.map(keyword=><a href={`#${expressionId(keyword.english)}`}><TimeIcon name={keyword.english}/><span><strong lang="en">{keyword.english}</strong><small>{keyword.meaning}</small></span></a>)}</div>
</nav>
<section id="ban-do" class="time-situations" aria-labelledby="situations-title"><h2 id="situations-title">Cùng một từ. Ba tình huống khác nhau.</h2><div class="time-situation-grid">
 <a href="#nhung-lan" class="time-situation time-situation-again"><TimeScene kind="again"/><div class="time-situation-body"><h3>Hẹn gặp lại</h3><p class="time-dialogue" lang="en">“<strong>Next time</strong>, let’s meet earlier.”</p><p class="time-dialogue-meaning">Lần sau, mình gặp nhau sớm hơn nhé.</p><p class="time-situation-lesson"><strong>time = lần</strong><span>Một dịp xảy ra của sự việc</span></p></div></a>
 <a href="#quy-thoi-gian" class="time-situation time-situation-waiting"><TimeScene kind="waiting"/><div class="time-situation-body"><h3>Chờ xe buýt</h3><p class="time-dialogue" lang="en">“Let’s play a game to <strong>kill time</strong>.”</p><p class="time-dialogue-meaning">Chơi một trò cho qua thời gian nhé.</p><p class="time-situation-lesson"><strong>time = khoảng thời gian</strong><span>Khoảng chờ có thể được lấp bằng một việc</span></p></div></a>
 <a href="#dong-ho" class="time-situation time-situation-arrival"><TimeScene kind="arrival"/><div class="time-situation-body"><h3>Đúng giờ hẹn</h3><p class="time-dialogue" lang="en">“The meeting started <strong>on time</strong>.”</p><p class="time-dialogue-meaning">Cuộc họp bắt đầu đúng giờ.</p><p class="time-situation-lesson"><strong>time = thời điểm</strong><span>Mốc giờ đã được lên lịch</span></p></div></a>
</div></section>
{groups.map(group=><section id={group.id} class="time-group"><div class="time-group-heading"><span class="time-group-icon" aria-hidden="true">{group.icon}</span><div><span class="time-label">{group.tag}</span><h2>{group.title}</h2></div></div><p class="time-group-intro">{group.description}</p>{group.id==='nhung-lan'&&<div class="time-mini-story" aria-label="Câu chuyện từ lần trước đến lần sau"><div class="time-moment time-moment-past"><TimeIcon name="Last time"/><span class="time-moment-context">Quên mang vở</span><p lang="en"><strong>Last time</strong><br/>I forgot my notebook.</p><span class="time-moment-meaning">Lần trước tôi quên mang vở.</span></div><div class="time-moment time-moment-now"><TimeIcon name="This time"/><span class="time-moment-context">Đã chuẩn bị xong</span><p lang="en"><strong>This time</strong><br/>I’m ready.</p><span class="time-moment-meaning">Lần này tôi đã sẵn sàng.</span></div><div class="time-moment time-moment-next"><TimeIcon name="Next time"/><span class="time-moment-context">Hẹn sớm hơn</span><p lang="en"><strong>Next time</strong><br/>let’s meet earlier.</p><span class="time-moment-meaning">Lần sau mình gặp sớm hơn nhé.</span></div></div>}<div class="time-cards">{group.cards.map(card=><section class="time-card" id={expressionId(card[0])} tabindex="-1"><div class="time-card-top"><TimeIcon name={card[0]}/><div><h3 lang="en">{card[0]}</h3><p>{card[1]}</p></div></div><div class="time-example"><p lang="en">{card[2]}</p><p>{card[3]}</p></div><p class="time-tip">{card[4]}</p></section>)}</div></section>)}
<section id="de-nham" class="time-caution"><span class="time-label">MỘT CHỖ RẤT DỄ HỌC NHẦM</span><h2 lang="en">Last time &amp; the last time</h2><p><strong>Last time</strong> thường là “lần trước”. Nhưng <strong>the last time</strong> có thể là “lần gần nhất” hoặc “lần cuối cùng”, tùy câu chuyện. Đừng học máy móc rằng cứ có <span lang="en">the</span> là sẽ không bao giờ xảy ra nữa.</p><div class="time-contrast"><div><span>LẦN GẦN NHẤT</span><p lang="en">The last time I saw Lan, she was in Hanoi.</p><p>Lần gần nhất tôi gặp Lan, cô ấy đang ở Hà Nội. Câu này không nói rằng sau đó tôi sẽ không gặp Lan nữa.</p></div><div><span>LẦN CUỐI CÙNG</span><p lang="en">This is the last time I’ll lend you my bike.</p><p>Đây là lần cuối tôi cho bạn mượn xe đạp. Người nói muốn khẳng định sẽ không cho mượn thêm nữa.</p></div></div><p class="time-rule">Mẹo nhớ: đọc cả câu và ý định của người nói, thay vì suy ra nghĩa chỉ từ một chữ “the”.</p></section>
<section id="luyen-tap" class="time-practice"><span class="time-label">THỬ NHỚ TRƯỚC KHI XEM LẠI</span><h2>Điền một cụm, hoàn thành một tình huống</h2><p id="exercise-help">Điền cụm tiếng Anh phù hợp. Không phân biệt hoa/thường; dấu chấm hoặc dấu chấm than cuối đáp án đều được. Thử trước, rồi kiểm tra hoặc mở đáp án từng câu.</p><form id="time-quiz" aria-describedby="exercise-help">{questions.map((q,i)=><div class="time-question"><label for={`time-answer-${i}`}><span lang="en">{q.before} <span class="time-blank">_____</span>{q.after}</span></label><input id={`time-answer-${i}`} data-answer={q.answer} type="text" autocomplete="off" spellcheck="false" placeholder="Cụm từ của bạn…" aria-describedby={`time-feedback-${i}`}/><p id={`time-feedback-${i}`} class="time-feedback" data-feedback></p><details><summary>Xem đáp án và nghĩa</summary><p><strong lang="en">{q.answer}</strong> · {q.meaning}</p></details></div>)}<div class="time-quiz-actions" hidden id="time-quiz-actions"><button type="submit" class="primary-button">Kiểm tra 5 câu</button><button type="reset" class="time-reset">Làm lại</button></div><p id="time-score" role="status" aria-live="polite"></p><noscript><p>Không cần JavaScript để học bài: bạn vẫn có thể viết câu trả lời và mở từng đáp án để tự so sánh.</p></noscript></form></section>
<section id="tu-noi" class="time-life"><span class="time-label">BIẾN TỪ VỰNG THÀNH CÂU CỦA BẠN</span><h2>Ba câu về chính mình</h2><p>Thay phần gợi ý bằng trải nghiệm thật, rồi nói thành tiếng. Bạn không cần dùng tất cả 13 cụm cùng lúc.</p><ol><li><b lang="en">In my free time, I …</b><span>Trong thời gian rảnh, tôi… Hãy thêm một sở thích.</span></li><li><b lang="en">Last time, I … This time, I …</b><span>Kể một điều đã thay đổi giữa lần trước và lần này.</span></li><li><b lang="en">Next time, I’ll …</b><span>Nói một việc bạn dự định làm tốt hơn vào lần sau.</span></li></ol><div class="time-recall"><h3>Ôn theo hai chiều</h3><p>Che phần tiếng Việt, nhìn cụm tiếng Anh và nói nghĩa. Sau đó đổi chiều: nhìn nghĩa tiếng Việt, nhớ lại cụm tiếng Anh rồi đặt một câu mới. Đặc biệt thử phân biệt <span lang="en">waste time</span> với <span lang="en">kill time</span>.</p></div></section>
<section id="nguon" class="time-sources"><h2>Nguồn &amp; cách biên soạn</h2><p>Danh sách 13 cụm từ lấy cảm hứng từ video dạng bảng chữ “13 cụm từ tiếng Anh bạn dùng mỗi ngày” của <a href="https://www.tiktok.com/@hoctienganhcungmsnga/video/7666064339723586836">@hoctienganhcungmsnga trên TikTok</a>. Bài học này sắp xếp lại theo ngữ cảnh, bổ sung ví dụ, lưu ý ngữ pháp và bài tập; không phải bản chép lời âm thanh.</p><p>Nghĩa của <span lang="en">last</span> và <span lang="en">last time</span> được đối chiếu với Cambridge Dictionary: <a href="https://dictionary.cambridge.org/us/dictionary/english/last">last: gần nhất hoặc cuối cùng</a> và <a href="https://dictionary.cambridge.org/us/dictionary/english/last-time">the last time: lần cuối cùng</a>. Các câu ví dụ và phần luyện tập được biên soạn cho bài học.</p></section>
</article>
<script>
const form=document.querySelector<HTMLFormElement>('#time-quiz')!;
const fields=[...form.querySelectorAll<HTMLInputElement>('input[data-answer]')];
const score=document.querySelector<HTMLElement>('#time-score')!;
const normalize=(value:string)=>value.trim().toLowerCase().replace(/[.!?]+$/,'').trim().replace(/\s+/g,' ').replace(/[’‘]/g,"'");
document.querySelector<HTMLElement>('#time-quiz-actions')!.hidden=false;
form.addEventListener('submit',event=>{event.preventDefault();let correct=0;fields.forEach(field=>{const value=normalize(field.value);const expected=normalize(field.dataset.answer!);const ok=value===expected||(expected==='time is up'&&value==="time's up");if(ok)correct++;field.setAttribute('aria-invalid',String(!ok));const feedback=document.getElementById(field.getAttribute('aria-describedby')!)!;feedback.textContent=ok?'Đúng rồi!':value?'Chưa đúng. Thử lại hoặc mở đáp án bên dưới.':'Bạn chưa điền câu này.';feedback.dataset.correct=String(ok);});score.textContent=`Bạn trả lời đúng ${correct}/5 câu. ${correct===5?'Rất tốt! Hãy thử đặt câu của riêng bạn.':'Bạn có thể sửa và kiểm tra lại.'}`;});
form.addEventListener('reset',()=>{fields.forEach(field=>field.removeAttribute('aria-invalid'));form.querySelectorAll<HTMLElement>('[data-feedback]').forEach(el=>{el.textContent='';delete el.dataset.correct;});form.querySelectorAll('details').forEach(el=>el.open=false);score.textContent='Đã làm lại. Hãy thử nhớ mà không xem đáp án.';});
fields.forEach(field=>field.addEventListener('input',()=>{field.removeAttribute('aria-invalid');document.getElementById(field.getAttribute('aria-describedby')!)!.textContent='';score.textContent='';}));
</script>
</LessonLayout>
