---
import LessonLayout from '../layouts/LessonLayout.astro';
import EnvironmentArt from '../components/EnvironmentArt.astro';
import Icon from '../components/Icon.astro';
import { lessons, href } from '../data/lessons';
const stages = [
 {kind:'dev' as const,tag:'DEVELOPMENT',short:'DEV',title:'Viết & thử',text:'Nơi bạn viết mã, thử ý tưởng và sửa lỗi. Có thể chạy trên máy cá nhân hoặc một môi trường phát triển riêng.',note:'Tự do thử nghiệm',number:'01'},
 {kind:'staging' as const,tag:'PRE-RELEASE',short:'STAGING',title:'Kiểm tra trước khi ra mắt',text:'Môi trường gần giống Production để kiểm thử toàn bộ ứng dụng và phát hiện vấn đề trước khi phát hành.',note:'Diễn tập trước giờ G',number:'02'},
 {kind:'production' as const,tag:'LIVE',short:'PRODUCTION',title:'Phục vụ người dùng',text:'Nơi ứng dụng chạy chính thức. Mọi thay đổi đều cần được theo dõi, vì chúng ảnh hưởng đến người dùng thật.',note:'Ổn định là ưu tiên',number:'03'},
];
---
<LessonLayout title="Dev, Staging, Production" topic="DevOps" current="" sections={[{id:'tong-quan',label:'Tổng quan'},{id:'trien-khai',label:'Luồng triển khai'},{id:'vi-du',label:'Ví dụ thực tế'}]}>
<section id="tong-quan"><div class="eyebrow"><span class="eyebrow-line"></span> HIỂU CÁCH MỘT ỨNG DỤNG RA ĐỜI</div><h1 class="lesson-title">Dev, Staging, Production<span class="blue-period">.</span></h1><p class="lead">Từ máy của bạn đến người dùng.</p><div class="lesson-meta"><span><Icon name="clock" size={14}/> 5 phút đọc</span><span class="meta-dot">·</span><span>Kiến thức nền tảng</span></div>
<div class="environment-grid">{stages.map((stage,i)=><div class="environment"><div class="art-wrap"><EnvironmentArt kind={stage.kind}/>{i<2&&<span class="environment-arrow"><Icon name="arrow" size={27}/></span>}</div><div class="env-label"><span class="status-light"></span>{stage.short}</div><div class="env-body"><span class="env-number">{stage.number}</span><h2>{stage.title}</h2><p>{stage.text}</p><span class="env-note">{stage.note}</span></div></div>)}</div>
<div class="takeaway"><Icon name="info" size={19}/><p>Cùng một ứng dụng, ba mục đích khác nhau: <strong>phát triển → kiểm chứng → sử dụng thật.</strong></p></div></section>
<section class="pipeline-section" id="trien-khai"><div class="section-heading"><div><span class="small-label">TỪ Ý TƯỞNG ĐẾN PHÁT HÀNH</span><h2>Một lần triển khai</h2></div><span class="outline-badge">CI / CD</span></div><p class="section-intro">Mỗi thay đổi đi qua một chuỗi kiểm tra. Tự động hóa giúp quá trình này<br class="desktop-only"/> nhất quán hơn, nhưng không thay thế việc kiểm chứng.</p><ol class="pipeline" aria-label="Các bước triển khai">{[{icon:'code',name:'Code',desc:'Đẩy mã lên repository'},{icon:'layers',name:'Build',desc:'Tạo phiên bản ứng dụng'},{icon:'check',name:'Test',desc:'Chạy các kiểm thử'},{icon:'arrow',name:'Deploy',desc:'Đưa lên môi trường đích'}].map((step,i)=><li data-step={i}><span class="step-icon"><Icon name={step.icon} size={25}/></span><div><h3>{step.name}</h3><p>{step.desc}</p></div><span class="step-number">0{i+1}</span></li>)}</ol><div class="simulation-controls"><button id="simulate" class="primary-button"><Icon name="play" size={15}/><span>Chạy mô phỏng</span></button><p id="simulation-status" role="status">Một ví dụ minh họa, không triển khai mã thật.</p></div></section>
<section id="vi-du" class="example-section"><div class="section-heading"><div><span class="small-label">ĐẶT VÀO THỰC TẾ</span><h2>Thêm nút “Lưu bài viết”</h2></div><span class="example-tag">VÍ DỤ MINH HỌA</span></div><div class="example-grid"><div class="example-story"><p>Bạn vừa thêm một tính năng nhỏ vào website. Thay vì đưa ngay cho mọi người dùng, hãy đi qua ba bước:</p><ol><li><strong>Dev:</strong> Viết nút bấm và thử trạng thái đã lưu.</li><li><strong>Staging:</strong> Kiểm tra trên điện thoại, thử lỗi mạng và kiểm tra quyền truy cập.</li><li><strong>Production:</strong> Phát hành phiên bản đã kiểm tra, theo dõi lỗi và chuẩn bị cách quay lui.</li></ol></div><aside class="note-card"><span class="small-label">ĐIỀU DỄ NHẦM</span><h3>Staging không phải<br/>“bản sao tuyệt đối”.</h3><p>Nên gần Production về cấu hình, nhưng dữ liệu và quyền truy cập cần tách biệt. Tránh dùng dữ liệu nhạy cảm thật để thử nghiệm.</p></aside></div></section>

<section class="lesson-catalog" aria-labelledby="catalog-heading"><span class="small-label">TIẾP TỤC KHÁM PHÁ</span><h2 id="catalog-heading">Các bài học</h2><div>{lessons.filter(lesson=>lesson.path).map(lesson=><a href={href(lesson.path)}><span>{lesson.topic}</span><strong>{lesson.title}</strong><Icon name="arrow" size={18}/></a>)}</div></section>
<style>.lesson-catalog{margin-top:44px;padding-top:25px;border-top:1px solid var(--line)}.lesson-catalog h2{font-size:24px;margin:8px 0 20px}.lesson-catalog>div{display:grid;grid-template-columns:1fr 1fr;gap:12px}.lesson-catalog a{border:1px solid var(--line);background:var(--panel);border-radius:8px;padding:17px;display:grid;grid-template-columns:1fr auto;gap:7px}.lesson-catalog a:hover{border-color:var(--blue)}.lesson-catalog a span{grid-column:1/-1;color:var(--muted);font-size:10px}.lesson-catalog strong{font-size:13px}@media(max-width:520px){.lesson-catalog>div{grid-template-columns:1fr}}</style>
<script>
const button=document.querySelector<HTMLButtonElement>('#simulate')!;
const status=document.querySelector<HTMLElement>('#simulation-status')!;
const steps=[...document.querySelectorAll<HTMLElement>('[data-step]')];
const messages=['Code: đã nhận thay đổi từ repository.','Build: đang tạo phiên bản ứng dụng.','Test: đang kiểm tra hành vi mong đợi.','Deploy: đang đưa phiên bản lên Staging.'];
button.addEventListener('click',async()=>{if(button.disabled)return;button.disabled=true;button.querySelector('span')!.textContent='Đang mô phỏng…';steps.forEach(s=>s.classList.remove('running','complete'));for(let i=0;i<steps.length;i++){steps[i].classList.add('running');status.textContent=messages[i];await new Promise(resolve=>setTimeout(resolve,1000));steps[i].classList.remove('running');steps[i].classList.add('complete');}status.textContent='Hoàn tất mô phỏng! Tiếp theo: kiểm chứng trên Staging trước khi lên Production.';button.disabled=false;button.querySelector('span')!.textContent='Chạy lại mô phỏng';});
</script>
</LessonLayout>
